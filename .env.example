# ---------------------------------------------------------------------------
# Secure Digital Document Management System — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
# Comma-separated trusted origins for CSRF (reverse-proxy host), optional:
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (defaults to SQLite for dev/tests) ---------------------------
# Use "postgresql" in production.
DJANGO_DATABASE_ENGINE=sqlite
DJANGO_DATABASE_NAME=db.sqlite3
DJANGO_DATABASE_USER=
DJANGO_DATABASE_PASSWORD=
DJANGO_DATABASE_HOST=
DJANGO_DATABASE_PORT=
DJANGO_DATABASE_CONN_MAX_AGE=60

# --- Security -----------------------------------------------------------------
# Enable behind TLS in production.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false

# --- Officer ID generation -----------------------------------------------------
ACCOUNTS_OFFICER_ID_PREFIX=OFF-
ACCOUNTS_OFFICER_ID_WIDTH=3

# --- Login protection -----------------------------------------------------------
ACCOUNTS_MAX_FAILED_ATTEMPTS=5
ACCOUNTS_LOCKOUT_MINUTES=15
ACCOUNTS_COOLDOWN_SECONDS=3
ACCOUNTS_RATE_LIMIT_WINDOW_SECONDS=300
ACCOUNTS_RATE_LIMIT_MAX_ATTEMPTS=20

# --- Session --------------------------------------------------------------------
ACCOUNTS_SESSION_MAX_AGE_MINUTES=480
ACCOUNTS_SESSION_INACTIVITY_MINUTES=30
ACCOUNTS_REAUTH_INTERVAL_SECONDS=600

# --- Secret-code (2nd factor) ---------------------------------------------------
# 64-char pepper used in the salted HMAC digest. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ACCOUNTS_SECRET_CODE_PEPPER=change-me-to-a-random-64-char-hex-string

# --- Classified portal required clearance ---------------------------------------
ACCOUNTS_CLASSIFIED_MIN_CLEARANCE=L4
